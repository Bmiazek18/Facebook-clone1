      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (job, status)",
          "legendFormat": "{{job}} - {{status}}",
          "range": true
        }
      ],
      "title": "HTTP 5xx Server Errors (rate)",
      "type": "timeseries"
    },
