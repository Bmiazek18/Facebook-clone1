@tool
def get_required_project_facts(query: str):
    """
    Szuka informacji w dokumentach projektowych.
    Zwraca zdania lub całe tabele wraz z REF_ID do podświetlenia.
    """
    try:
        query_vector = get_embedding(query, is_query=True)
        v_results = collection.query(query_embeddings=[query_vector], n_results=3)

        found_ids = v_results['ids'][0]
        distances = v_results['distances'][0] if 'distances' in v_results else [0.0]

        # Walidacja dopasowania kosinusowego w celu uniknięcia wstrzykiwania szumu do pytań typu small talk
        if not found_ids or (len(distances) > 0 and distances[0] > 0.75):
            return "W lokalnej dokumentacji nie ma żadnych informacji na ten temat. Odpowiedz użytkownikowi wyłącznie na podstawie własnej wiedzy ogólnej lub historii waszej rozmowy."

        all_context_blocks = []
        already_added = set()

        for d_id in found_ids:
            parts = d_id.split("_")
            base_name = "_".join(parts[:-1])
            try:
                current_idx = int(parts[-1])
            except ValueError:
                continue

            start_idx = max(0, current_idx - 2)
            end_idx = current_idx + 3

            window_ids = [f"{base_name}_{i}" for i in range(start_idx, end_idx)]
            window_data = collection.get(ids=window_ids)

            sorted_items = sorted(
                zip(window_data['ids'], window_data['documents']),
                key=lambda x: int(x[0].split("_")[-1])
            )

            for wid, doc in sorted_items:
                if wid not in already_added:
                    all_context_blocks.append(f"=== BLOK DANYCH (REF_ID: {wid}) ===\n{doc}\n")
                    already_added.add(wid)

        context_to_llm = "\n".join(all_context_blocks)
        print(f"\n[RAG WINDOW] Pobrano {len(already_added)} unikalnych bloków dla zapytania.")

        prompt = (
            f"Poniżej znajdują się fragmenty dokumentacji (wraz z ich ID):\n\n"
            f"{context_to_llm}\n"
            "ZADANIE:\n"
            "Odpowiedz na pytanie użytkownika. Jeśli pytanie wymaga obliczeń "
            "(np. ID = indeks mod 5), wykonaj je krok po kroku.\n"
            "BARDZO WAŻNE: Po każdej informacji (zdaniu, wyniku, wierszu tabeli) "
            "podaj tag [REF_ID](tutaj_id_bloku), z którego ta informacja pochodzi. "
            "Jeśli informacja wynika z kilku bloków, podaj wszystkie pasujące ID."
        )
        return prompt

    except Exception as e:
        print(f"❌ Błąd w get_required_project_facts: {e}")
        return "Wystąpił błąd podczas przeszukiwania dokumentacji."


@tool
def generate_and_save_chart(chart_config_json: str) -> str:
    """
    Generuje wykres na podstawie konfiguracji JSON i zwraca znacznik ścieżki.
    Struktura JSON: {"title": "Tytuł", "type": "bar"|"line"|"pie", "labels": [], "values": []}
    """
    try:
        output_dir = "generated_charts"
        if not os.path.exists(output_dir):
            os.makedirs(output_dir)

        config = json.loads(chart_config_json)
        title = config.get("title", "Wykres")
        chart_type = config.get("type", "bar").lower()
        labels = config.get("labels", [])
        values = config.get("values", [])

        if not labels or not values:
            return "Błąd: Brak danych do wykresu."

        plt.figure(figsize=(10, 6))
        plt.rcParams['font.family'] = 'sans-serif'

        if chart_type == "bar":
            plt.bar(labels, values, color='skyblue', edgecolor='black')
        elif chart_type == "line":
            plt.plot(labels, values, marker='o', color='green')
        elif chart_type == "pie":
            plt.pie(values, labels=labels, autopct='%1.1f%%')

        plt.title(title)
        plt.tight_layout()

        filename = f"chart_{hashlib.md5(title.encode()).hexdigest()[:8]}.png"
        file_path = os.path.join(output_dir, filename)

        plt.savefig(file_path, dpi=150)
        plt.close()

        return f"__CHART_FILE__:{file_path}__"

    except Exception as e:
        plt.close()
        return f"Błąd generowania: {str(e)}"


