# --- ASYNCHRONICZNY LIFESPAN DLA AKTYWNEGO POŁĄCZENIA DB ---
@asynccontextmanager
async def lifespan(app: FastAPI):
    global agent_executor
    async with AsyncSqliteSaver.from_conn_string("chat_history.db") as chat_memory_db:
        print("Asynchroniczna baza danych punktów kontrolnych LangGraph została uruchomiona.")

        agent_executor = create_react_agent(
            local_llm,
            agent_tools,
            prompt=SYSTEM_PROMPT,
            checkpointer=chat_memory_db
        )
        yield

    print("Połączenie z asynchroniczną bazą danych historii zostało zamknięte.")


app = FastAPI(lifespan=lifespan)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


# --- ENDPOINT: HISTORIA CZATU DLA FRONTENDU ---

@app.get("/chat-history/{thread_id}")
async def get_chat_history(thread_id: str):
    if agent_executor is None:
        raise HTTPException(status_code=503, detail="Agent nie jest jeszcze zainicjalizowany.")

    config = {"configurable": {"thread_id": thread_id}}
    try:
        state = await agent_executor.aget_state(config)
        if not state or "messages" not in state.values:
            return {"messages": []}

        formatted_messages = []
        for msg in state.values["messages"]:
            if msg.type in ["human", "ai"]:
                role = "user" if msg.type == "human" else "assistant"

                if msg.type == "ai" and not msg.content and msg.tool_calls:
                    continue
                if role == "assistant" and "Zgodnie z dokumentacją, wirtualny świat" in str(msg.content):
                    continue

                formatted_messages.append({
                    "id": int(datetime.now().timestamp() * 1000) + len(formatted_messages),
                    "role": role,
                    "content": str(msg.content)
                })

        return {"messages": formatted_messages}
    except Exception as e:
        print(f"Błąd podczas pobierania historii: {e}")
        raise HTTPException(status_code=500, detail=str(e))


