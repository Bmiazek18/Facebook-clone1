# --- FUNKCJE POMOCNICZE (TEKST I EMBEDDINGI) ---

def strip_excessive_spaces(text):
    return re.sub(r' {3,}', '  ', text)


def clean_polish_text(text):
    text = unicodedata.normalize('NFC', text)
    chars_to_fix = ['ą', 'ę', 'ć', 'ś', 'ź', 'ż', 'ó', 'ł', 'ń']
    for char in chars_to_fix:
        text = text.replace(f" {char}", char)
    return text


def get_embedding(text, is_query=False):
    prefix = "query: " if is_query else "passage: "
    try:
        response = embed_client.embeddings.create(
            input=[f"{prefix}{text[:2000]}"],
            model="ipipan/silver-retriever-base-v1"
        )
        return response.data[0].embedding
    except Exception as e:
        print(f"Embedding error: {e}")
        return [0.0] * 768


# --- HYBRYDOWE PRZETWARZANIE PDF ---

def extract_and_chunk_pdf(source_input, is_b64=True):
    try:
        if is_b64:
            if "base64," in source_input: source_input = source_input.split("base64,")[1]
            pdf_data = io.BytesIO(base64.b64decode(source_input))
        else:
            pdf_data = source_input

        converter = DocumentConverter()
        result = converter.convert(pdf_data)

        raw_md = result.document.export_to_markdown()
        md_cleaned = clean_polish_text(raw_md)
        md_compact = strip_excessive_spaces(md_cleaned)

        blocks = md_compact.split("\n\n")

        final_chunks = []
        for block in blocks:
            block = block.strip()
            if not block: continue

            if "|" in block:
                final_chunks.append(block)
            else:
                sentence_splitter = RecursiveCharacterTextSplitter(
                    separators=[". ", "! ", "? "],
                    chunk_size=500,
                    chunk_overlap=0
                )
                sentences = sentence_splitter.split_text(block)
                for s in sentences:
                    s_clean = s.strip()
                    if len(s_clean) > 15:
                        if not s_clean.endswith(('.', '!', '?')): s_clean += "."
                        final_chunks.append(s_clean)

        return final_chunks, [{"source_type": "hybrid_markdown"} for _ in final_chunks]
    except Exception as e:
        print(f"Błąd parsera: {e}")
        return [], []


