@app.post("/process-chat")
async def process_chat(request: Request):
    data = await request.json()
    print(request)
    user_query = data.get("query", "")
    files = data.get("files", [])
    thread_id = data.get("thread_id", "default_session")

    # Indeksowanie plików PDF przesyłanych w locie
    for file in files:
        if not collection.get(where={"source": file['name']})['ids']:
            chunks, _ = extract_and_chunk_pdf(file['url'])
            if chunks:
                ids = [f"{hashlib.md5(file['name'].encode()).hexdigest()}_{i}" for i in range(len(chunks))]
                embeddings = [get_embedding(c) for c in chunks]
                collection.add(embeddings=embeddings, documents=chunks,
                               metadatas=[{"source": file['name']} for _ in chunks], ids=ids)

    # --- ROZBUDOWANA DIAGNOSTYKA HISTORII W TERMINALU BACKENDU ---
    print("\n" + "=" * 60)
    print(f"[BACKEND DB LOG] Nowe żądanie od thread_id: {thread_id}")
    print(f"[BACKEND DB LOG] Treść najnowszego pytania: '{user_query}'")
    print("-" * 60)

    try:
        current_db_state = await agent_executor.aget_state({"configurable": {"thread_id": thread_id}})
        if current_db_state and "messages" in current_db_state.values:
            history_messages = current_db_state.values["messages"]
            print(f"[BACKEND DB LOG] Stan SQLite: Znaleziono {len(history_messages)} wiadomości przed tym zapytaniem.")
            print("[BACKEND DB LOG] === PEŁNY PRZEBIEG DOTYCHCZASOWEJ ROZMOWY Z BAZY ===")

            for index, m in enumerate(history_messages):
                if m.type == "human":
                    label = "👤 UŻYTKOWNIK"
                elif m.type == "ai":
                    if not m.content and m.tool_calls:
                        continue
                    label = "✦ ASYSTENT"
                else:
                    label = f"⚙️ SYSTEM ({m.type})"

                print(f"  {index + 1}. [{label}]: {str(m.content).strip()}")
            print("[BACKEND DB LOG] ===================================================")
        else:
            print("[BACKEND DB LOG] Stan SQLite: Brak historii dla tego wątku (Rozpoczynamy nową rozmowę).")
    except Exception as db_err:
        print(f"❌ [BACKEND DB LOG] Błąd odczytu bazy: {db_err}")
    print("=" * 60 + "\n")

    async def stream():
        config = {"configurable": {"thread_id": thread_id}}

        # Słownik z listą krotek jako standardowy format wejściowy zapobiegający konfliktom LangGraph
        inputs = {"messages": [("user", user_query)]}

        async for msg, metadata in agent_executor.astream(
                inputs,
                config=config,
                stream_mode="messages"
        ):
            if msg.content and metadata.get("langgraph_node") == "agent":
                text_chunk = str(msg.content)

                # Parsowanie tagów wykresów z Matplotlib za pomocą Regex
                pattern = r"__CHART_FILE__:(.*?)__"
                match = re.search(pattern, text_chunk)

                if match:
                    full_tag = match.group(0)
                    file_path = match.group(1)

                    try:
                        if os.path.exists(file_path):
                            with open(file_path, "rb") as img_f:
                                b64 = base64.b64encode(img_f.read()).decode('utf-8')
                                img_md = f"\n![Wykres](data:image/png;base64,{b64})\n"
                                yield text_chunk.replace(full_tag, img_md)
                        else:
                            yield text_chunk.replace(full_tag, "[Błąd: Plik wykresu nie został znaleziony]")
                    except Exception as e:
                        yield text_chunk.replace(full_tag, f"[Błąd obrazu: {str(e)}]")
                else:
                    yield text_chunk

    return StreamingResponse(stream(), media_type="text/plain")


def ingest_data_folder():
    if not os.path.exists("data"):
        os.makedirs("data")
        return
    pdf_files = [f for f in os.listdir("data") if f.endswith(".pdf")]
    for f_name in pdf_files:
        print(f"Indeksowanie lokalne: {f_name}")
        collection.delete(where={"source": f_name})
        chunks, _ = extract_and_chunk_pdf(os.path.join("data", f_name), is_b64=False)
        if chunks:
            ids = [f"{hashlib.md5(f_name.encode()).hexdigest()}_{i}" for i in range(len(chunks))]
            embeddings = [get_embedding(c) for c in chunks]
            collection.add(embeddings=embeddings, documents=chunks,
                           metadatas=[{"source": f_name} for _ in chunks], ids=ids)
    print("Baza gotowa.")


